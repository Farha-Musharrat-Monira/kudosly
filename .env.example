APP_NAME=Kudosly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Production requires APP_ENV=production and APP_DEBUG=false.
# A debug build prints stack traces and configuration values, including
# secrets, on any error.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production should use LOG_LEVEL=info and LOG_STACK=stderr so the logs
# reach the platform's log collector instead of a file on the server.

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Production must set SESSION_SECURE_COOKIE=true, so the session cookie is
# only ever sent over an encrypted connection.
# SESSION_SECURE_COOKIE=false
# SESSION_SAME_SITE=lax

# The proxies whose forwarded headers may be trusted, comma separated.
# Leave empty unless the application really sits behind a proxy: an
# untrusted header must never be honoured, or a visitor could forge the
# address that the rate limiters key on.
# TRUSTED_PROXIES=

# Whether a new account must verify its email address before it can
# reach the dashboard. Verification is on unless this is turned off.
KUDOSLY_REQUIRE_EMAIL_VERIFICATION=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Production must set MAIL_MAILER to a real transport. The "log" mailer
# writes messages to the log file and sends nothing, so password reset and
# email verification messages would never arrive.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe (test mode) - Kudosly subscriptions
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=usd
STRIPE_PRICE_PRO=
